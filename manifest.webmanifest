{
  "name": "Hot Flash",
  "short_name": "Hot Flash",
  "description": "The automotive social network built around your vehicles, builds, events, and community.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#050607",
  "theme_color": "#ff4b19",
  "categories": ["social", "lifestyle", "automotive"],
  "icons": [
    {
      "src": "/assets/hot-flash-logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/hot-flash-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Discover Builds",
      "short_name": "Discover",
      "url": "/feed.html?source=pwa-shortcut",
      "icons": [{"src": "/assets/hot-flash-logo.png", "sizes": "192x192", "type": "image/png"}]
    },
    {
      "name": "My Garage",
      "short_name": "Garage",
      "url": "/dashboard.html?source=pwa-shortcut",
      "icons": [{"src": "/assets/hot-flash-logo.png", "sizes": "192x192", "type": "image/png"}]
    },
    {
      "name": "Nearby Events",
      "short_name": "Events",
      "url": "/events.html?source=pwa-shortcut",
      "icons": [{"src": "/assets/hot-flash-logo.png", "sizes": "192x192", "type": "image/png"}]
    }
  ]
}
